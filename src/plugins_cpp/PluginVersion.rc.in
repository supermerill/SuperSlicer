// This generated resource identifies a packaged C++ plugin without loading
// its code. PluginPackage.cmake fills every value from slic3r_package_plugin(),
// keeping the DLL metadata synchronized with version.ini and the archive name.

#include <winver.h>

1 VERSIONINFO
 FILEVERSION @PLUGIN_RC_NUMERIC_VERSION@
 PRODUCTVERSION @PLUGIN_RC_NUMERIC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SuperSlicer\0"
            VALUE "FileDescription", "@PLUGIN_RC_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PLUGIN_RC_PACKAGE_VERSION@\0"
            VALUE "InternalName", "@PLUGIN_RC_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "plugin.dll\0"
            VALUE "ProductName", "@PLUGIN_RC_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@PLUGIN_RC_PACKAGE_VERSION@\0"
            VALUE "SlicerVersion", "@PLUGIN_RC_SLICER_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
